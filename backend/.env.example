# ============================================================
# TEMPLATE DE VARIABLES DE ENTORNO
# Copiá este archivo a .env y completá los valores reales.
# Este archivo SÍ se commitea — nunca pongas credenciales acá.
# ============================================================

# Ambiente: development | production
NODE_ENV=development

# Puerto donde escucha el servidor
PORT=4000

# --- Base de datos (PostgreSQL) ---
DB_NAME=auth_db
DB_USER=postgres
DB_PASS=changeme
DB_HOST=localhost
DB_DIALECT=postgres
DB_PORT=5432

# --- JWT ---
# Generá uno nuevo por proyecto con: openssl rand -hex 64
# Cambiar esto invalida TODAS las sesiones activas.
JWT_SECRET=changeme

# --- CORS ---
# Origen(es) permitidos para el frontend.
# Separados por coma si son varios, sin barra al final.
# Ejemplo: http://localhost:5173,https://miapp.gob.ar
CORS_ORIGIN=http://localhost:5173

# --- Bootstrap inicial (solo development) ---
# DB_SYNC: crea/altera tablas automáticamente al arrancar.
#   true  → útil para dev local, NUNCA en producción
#   false → usar siempre migraciones: npm run migrate
DB_SYNC=false
