# URL base del backend — sin barra al final
# Development: http://localhost:4000/api
# Production:  https://tudominio.com/api
VITE_API_URL=http://localhost:4000/api

# Nombre de la app — se muestra en el login y en el sidebar
VITE_APP_NAME='Administracion'